* text=auto

# Shell 脚本必须是 LF，否则容器内 bash 会因 \r 报错
*.sh text eol=lf
mvnw text eol=lf

# Windows 批处理与 PowerShell 用 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# CI 与容器相关配置用 LF（YAML 含 CRLF 时部分解析器会报错）
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.sql text eol=lf
*.py text eol=lf
